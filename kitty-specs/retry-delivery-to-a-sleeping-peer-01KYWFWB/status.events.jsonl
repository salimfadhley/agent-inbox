{"aggregate_id": "01KYWFWBGS0KDHXVG10TMZYG8W", "aggregate_type": "Mission", "event_id": "01KYWFWBRBZA1TXB56KM0NFZY8", "event_type": "MissionCreated", "payload": {"created_at": "2026-07-31T16:24:53.530599+00:00", "friendly_name": "Retry delivery to a sleeping peer", "mission_id": "01KYWFWBGS0KDHXVG10TMZYG8W", "mission_number": null, "mission_slug": "retry-delivery-to-a-sleeping-peer-01KYWFWB", "mission_type": "software-dev", "purpose_context": "Federation currently delivers once and never retries, so a peer that is asleep, restarting or briefly offline turns an ordinary message into a failure. That is the common case for the hubs this project actually runs: the public demo suspends when idle and laptops sleep. This mission adds a short retry window so those sends succeed on their own, while keeping the guarantee that authorization is re-decided at the moment of each attempt and never inherited from when the message was queued.", "purpose_tldr": "A federated message to a peer that is briefly unreachable is retried rather than lost, and the sender can see which.", "target_branch": "kitty/mission-retry-delivery-to-a-sleeping-peer", "wp_count": 0}, "project_slug": "agent-mail", "project_uuid": "d4029717-cdee-49ee-a034-fea8e7368926", "schema_version": "5.0.0", "timestamp": "2026-07-31T16:24:53.771281+00:00"}
