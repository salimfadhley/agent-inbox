{"at": "2026-07-28T15:58:58.068217+00:00", "event_id": "01KYMQ6QGM52NMTVCW2H0QTH7S", "event_type": "DecisionPointResolved", "payload": {"actual_participants": [], "closed_locally_while_widened": false, "closure_message": null, "decision_point_id": "01KYMQ6PTT9J16PCA5H8FF66QX", "final_answer": "Lists are stored-only. Scalars keep env-over-stored precedence; peer lists and blocklists live only in the store and are edited through the UI. No environment equivalent, so no merge semantics and no second configuration shape.", "mission_id": "01KYJY10WCA0RC9KWGXXCYX1CG", "mission_slug": "manual-activitypub-federation-v1-01KYJY10", "mission_type": "software-dev", "origin_surface": "planning_interview", "other_answer": false, "rationale": null, "recorded_at": "2026-07-28T15:58:58.068217Z", "resolved_by": "cli", "run_id": "01KYMQ6PTT9J16PCA5H8FF66QX", "state_entered_at": "2026-07-28T15:58:58.067402Z", "summary": null, "terminal_outcome": "resolved"}}
