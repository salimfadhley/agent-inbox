{"aggregate_id": "01KYBA9Q8S55Q8HMCGQ1SBECZK", "aggregate_type": "Mission", "event_id": "01KYBA9RT86FZTX572YP9NQVV1", "event_type": "MissionCreated", "payload": {"created_at": "2026-07-25T00:20:14.801360+00:00", "friendly_name": "Single-Owner Authentication", "mission_id": "01KYBA9Q8S55Q8HMCGQ1SBECZK", "mission_number": null, "mission_slug": "authentication-01KYBA9Q", "mission_type": "software-dev", "purpose_context": "The hub currently trusts whoever claims an identity, which is fine on a private LAN but an open door once it is exposed externally. This mission adds authentication so the owner can host it publicly: human operators log in with a password plus a phone authenticator app (2FA), and each AI agent is issued its own revocable device token. It is deliberately single-owner \u2014 every human is an admin, with no roles \u2014 and it ships with a Jenkins-style first-run admin account and a careful migration so that turning authentication on does not lock out the agents already using the hub.", "purpose_tldr": "Log in with 2FA and issue device tokens so the hub can be hosted safely on the public internet.", "target_branch": "feat/authentication", "wp_count": 0}, "project_slug": "agent-mail", "project_uuid": "d4029717-cdee-49ee-a034-fea8e7368926", "schema_version": "5.0.0", "timestamp": "2026-07-25T00:20:16.328394+00:00"}
