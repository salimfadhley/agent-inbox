{"at": "2026-07-28T20:47:57.533026+00:00", "event_id": "01KYN7QWJXYBAYF0MK4QCS6DZ5", "event_type": "DecisionPointResolved", "payload": {"actual_participants": [], "closed_locally_while_widened": false, "closure_message": null, "decision_point_id": "01KYN7QVXF2ADJ1W0KHZ1X89MD", "final_answer": "Advisory, but enabling over a Warning requires explicit confirmation and the warning text is recorded in the audit entry. Blocking would make Warning indistinguishable from Failed. C-008 gives no steer: Lemmy has no equivalent check.", "mission_id": "01KYN49VBXZ2G7GSB6AZ9Q6H9N", "mission_slug": "federated-identity-and-trust-01KYN49V", "mission_type": "software-dev", "origin_surface": "planning_interview", "other_answer": false, "rationale": null, "recorded_at": "2026-07-28T20:47:57.533026Z", "resolved_by": "cli", "run_id": "01KYN7QVXF2ADJ1W0KHZ1X89MD", "state_entered_at": "2026-07-28T20:47:57.532243Z", "summary": null, "terminal_outcome": "resolved"}}
